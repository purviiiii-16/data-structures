#include<stdio.h>
#include<process.h>
#define MAX 5
int stack[];
int top = -1;
int items;
int i;
void push(){
    if (top == MAX-1){
      printf("Stack Overflow\n");
      return;
    }
    printf("Enter element to push:\n");
    scanf("%d",&items);
    top ++;
    stack[top]= items;
    }
void pop(){
    if (top == -1){
      printf("Stack Underflow\n");
      return;
      }
    printf("\n Stack elements are:");
      for (i=top;i>=0;i--){
      printf("%d\n",stack[i]);

      }
    }
void display(){
    if (top == -1){
      printf("Stack is empty");
      return;
      }
    printf("\n Stack elements are:");
      for (i=top;i>=0;i--){
      printf("%d\n",stack[i]);

      }
    }
int main()
{
int choice;
do
{
printf("\n----Stack menu----");
printf("1.Push\n");
printf("2.Pop\n");
printf("3.Display\n");
printf("4.Exit\n");

printf("Enter a choice:");
scanf("%d",&choice);

switch(choice){
    case 1 :
        push();
        break;
    case 2:
        pop();
        break;
    case 3 :
        display();
        break;
    case 4:
        printf("Exiting Program\n");
        break;
    default:
        printf("Invalid choice\n");
    }
}
    while(choice!=4);
    return 0;
    }



